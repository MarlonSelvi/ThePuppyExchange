@model DataAccessLayer.Entities.CustomerModel

@{
    ViewData["Title"] = "Registration";
}

<style>
    .register-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 75vh;
    }

    .register-card {
        background-color: var(--puppy-card-bg);
        border-radius: 16px;
        padding: 2.5rem;
        max-width: 420px;
        width: 100%;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

        .register-card h2 {
            font-family: 'Times New Roman', Times, serif;
            color: #333;
            font-weight: 700;
            text-align: center;
            margin-bottom: 0.25rem;
        }

    .register-subtitle {
        text-align: center;
        color: #888;
        font-size: 0.95rem;
        margin-bottom: 1.75rem;
    }

    .register-puppy-icon {
        display: block;
        margin: 0 auto 1rem auto;
        font-size: 3rem;
        color: var(--puppy-logo-gold);
        text-align: center;
    }

    .register-card .form-control {
        border-radius: 10px;
        border: 1px solid #d4d0c2;
        padding: 0.65rem 1rem;
        font-size: 0.95rem;
    }

        .register-card .form-control:focus {
            border-color: var(--puppy-logo-gold);
            box-shadow: 0 0 0 0.2rem rgba(163, 150, 93, 0.2);
        }

    .register-card label {
        font-family: 'Times New Roman', Times, serif;
        color: #333;
        font-weight: 600;
        margin-bottom: 0.3rem;
    }

    .btn-puppy {
        background-color: var(--puppy-logo-gold);
        border: none;
        color: #fff;
        font-family: 'Times New Roman', Times, serif;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.6rem;
        width: 100%;
        transition: background-color 0.3s;
    }

        .btn-puppy:hover {
            background-color: #8a7e4e;
            color: #fff;
        }

    .register-footer {
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.9rem;
        color: #666;
    }

        .register-footer a {
            color: var(--puppy-logo-gold);
            font-weight: 600;
            text-decoration: none;
        }

            .register-footer a:hover {
                text-decoration: underline;
            }

    .register-paw {
        color: var(--puppy-logo-gold);
        font-size: 1rem;
    }

    .name-row {
        display: flex;
        gap: 1rem;
    }

        .name-row > div {
            flex: 1;
        }
</style>

<div class="register-wrapper">
    <div class="register-card">
        <div class="register-puppy-icon">
        </div>
        <h2>Join the Pack</h2>

        <form asp-action="Registration">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="name-row mb-3">
                <div>
                    <label asp-for="fname" class="form-label">First Name</label>
                    <input asp-for="fname" class="form-control" placeholder="John" />
                    <span asp-validation-for="fname" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="lname" class="form-label">Last Name</label>
                    <input asp-for="lname" class="form-control" placeholder="Doe" />
                    <span asp-validation-for="lname" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="email" class="form-label">Email</label>
                <input asp-for="email" class="form-control" placeholder="email@domain.com" />
                <span asp-validation-for="email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="password" class="form-label">Password</label>
                <div class="position-relative">
                    <input asp-for="password" type="password" class="form-control pe-5" placeholder="••••••••••" autocomplete="new-password" />
                    <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y me-2 p-0 border-0 bg-transparent"
                            onclick="togglePassword(this)" tabindex="-1">
                        <i class="bi bi-eye" style="font-size: 1.2rem; color: #888;"></i>
                    </button>
                </div>
                <span asp-validation-for="password" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-puppy">Create Account</button>
            </div>
        </form>

        <div class="register-footer">
            Already have an account? <a asp-controller="Customer" asp-action="Login">Log in here</a>
        </div>
    </div>
</div>

<script>
    function togglePassword(btn) {
        var input = btn.previousElementSibling;
        var icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}