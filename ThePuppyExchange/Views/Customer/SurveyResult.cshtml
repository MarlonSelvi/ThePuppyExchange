@model ThePuppyExchange.Models.SurveyResultViewModel
@{
    ViewData["Title"] = "Your Match";
}

<div class="container" style="max-width: 700px; margin: 3rem auto; text-align:center;">
    <h2 class="dashboard-title">Your Recommended Breed</h2>

    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h3 style="color: var(--puppy-logo-gold); font-weight: 700;">
            @Model.RecommendedBreed
        </h3>
        <p class="mt-3" style="font-size: 1.05rem; color:#444;">
            @Model.Reasoning
        </p>

        <a asp-controller="Puppy"
           asp-action="Catalog"
           asp-route-selectedBreed="@Model.RecommendedBreed"
           class="btn mt-3"
           style="background: var(--puppy-logo-gold); color:#222; border-radius:30px; padding:.6rem 2rem; align-self:center;">
            Browse @Model.RecommendedBreed Puppies
        </a>
    </div>
</div>