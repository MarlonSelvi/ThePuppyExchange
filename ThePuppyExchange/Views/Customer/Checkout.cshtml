@model List<Checkout>

@{
    ViewData["Title"] = "Checkout";

    var total = Model.Sum(i => i.fee * i.quantity);
}

<div class="container py-5">

    <h1 class="mb-4" style="font-family: 'Times New Roman', Times, serif;">
        Checkout
    </h1>

    <div class="row">
        <div class="col-md-6">
            <h4 class="mb-3">Billing Information</h4>

            <form asp-controller="Customer" asp-action="PlaceOrder" method="post">

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="FullName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="Email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <input type="text" name="Address" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">City</label>
                    <input type="text" name="City" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Card Number</label>
                    <input type="text" name="CardNumber" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-lg mt-3"
                        style="background-color: #a3965d; color: #fff;">
                    Place Order
                </button>
            </form>
        </div>


        <div class="col-md-6">
            <h4 class="mb-3">Order Summary</h4>

            <ul class="list-group mb-3">
                @foreach (var item in Model)

                {
                    <li class="list-group-item d-flex justify-content-between">
                        <div>
                            <h6 class="my-0">@item.name</h6>
                            <small class="text-muted">Qty: @item.quantity</small>
                        </div>
                        <span class="text-success">
                            $@(item.fee * item.quantity)
                        </span>
                    </li>
                }

                <li class="list-group-item d-flex justify-content-between">
                    <strong>Total</strong>
                    <strong>$@total</strong>
                </li>
            </ul>

            <a asp-controller="Customer" asp-action="Cart"
               class="btn btn-outline-secondary w-100">
                ← Back to Cart
            </a>
        </div>
    </div>
</div>