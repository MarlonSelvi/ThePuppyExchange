@model DataAccessLayer.Entities.OrderModel

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5 text-center">

    <h1 class="mb-4" style="font-family: 'Times New Roman', Times, serif;">
        Order Confirmed!
    </h1>

    <div class="alert alert-success">
        <h4 class="mb-0">Thank you for your order!</h4>
    </div>

    <div class="card mx-auto mt-4" style="max-width: 400px;">
        <div class="card-body">
            <p><strong>Order ID:</strong> @Model.id</p>
            <p><strong>Date:</strong> @Model.date.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>

    <a asp-controller="Puppy" asp-action="Catalog" class="btn btn-lg mt-4"
       style="background-color: #a3965d; color: #fff;">
        ← Back to Catalog
    </a>

</div>